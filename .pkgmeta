# CurseForge / BigWigs packager config: the zip contains one folder, packRat/,
# with the .toc, Lua files, Bindings.xml, Media and the embedded Libs/.
package-as: packRat

# Embedded for the minimap button and the LDB feed.
externals:
  Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1
  Libs/LibDBIcon-1.0: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

ignore:
  - tests
  - tools
  - assets
  - README.md
  - CHANGELOG.md
  - CURSEFORGE.md
  - dist

# Release notes on CurseForge come from here.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

enable-nolib-creation: no
